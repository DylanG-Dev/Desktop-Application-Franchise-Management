<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.QuadCurve?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@./css/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinema.controllers.ListeFranchiseController">

    <top>
        <MenuBar>
            <menus>
                <Menu fx:id="gestionFranchise" mnemonicParsing="false" text="Gestion franchises">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@../images/franchise_64x64.png" /></image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bListeFranchise" mnemonicParsing="false" onAction="#bListFranchiseClick" text="Liste franchises" />
                        <MenuItem fx:id="bAjouterFranchise" mnemonicParsing="false" onAction="#bAjouterFranchiseClick" text="Ajouter une franchise" />
                    </items>
                </Menu>
                <Menu fx:id="gestionCinema" mnemonicParsing="false" text="Gestion cinéma">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@../images/cinema_32x32.png" /></image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bListeCinema" mnemonicParsing="false" onAction="#bListeCinemaClick" text="Liste des cinémas" />
                        <MenuItem fx:id="bAjouterCinema" mnemonicParsing="false" onAction="#bAjouterCinemaClick" text="Ajouter un cinéma" />
                    </items>
                </Menu>
                <Menu fx:id="gestionSalle" mnemonicParsing="false" text="Gestion salles">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@../images/salle_32x32.png" /></image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bListeSalle" mnemonicParsing="false" onAction="#bListeSalleClick" text="Liste salles" />
                        <MenuItem fx:id="bAjouterSalle" mnemonicParsing="false" onAction="#bAjouterSalleClick" text="Ajouter une salle" />
                    </items>
                </Menu>
                <Menu fx:id="bAutres" mnemonicParsing="false" text="Autres">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image><Image url="@../images/info.png" /></image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bAccueil" mnemonicParsing="false" onAction="#bAccueilClick" text="Accueil" />
                        <MenuItem fx:id="bQuitter" mnemonicParsing="false" onAction="#bQuitterClick" text="Quitter" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <TableView fx:id="tvFranchises">
            <columns>
                <TableColumn fx:id="tcNomFranchise" prefWidth="150.0" text="tcNomFranchise" />
                <TableColumn fx:id="tcSiegeSocial" prefWidth="160.0" text="tcSiegeSocial" />
                <TableColumn fx:id="tcGerant" prefWidth="210.0" text="tcGerant" />
                <TableColumn fx:id="tcSupprimer" prefWidth="110.0" text="tcSupprimer" />
                <TableColumn fx:id="tcModifier" prefWidth="110.0" text="tcModifier" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <!--
            The bottom zone is an AnchorPane of fixed height.
            - The button is anchored to the top-center (left+right=0 centers it).
            - Left curve : starts at bottom-left corner, control point pulls UP-LEFT,
              end point is also off-screen bottom-left  →  produces a hill on the left.
            - Right curve: mirror on the right side.
            Both curves are anchored to the bottom so they always sit at the very bottom.
        -->
        <AnchorPane prefHeight="115.0">
            <!-- BUTTON CENTER CONTAINER -->
            <StackPane AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="42.0">

                <Button fx:id="bRetour" alignment="center" onAction="#bRetourClick" prefHeight="39.0" prefWidth="200" text="RETOUR" textFill="#024010">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>

            </StackPane>

            <!--
                LEFT curve:
                  start = far bottom-left (off screen)
                  control = upper-left area  → pulls the curve UP on the left
                  end = bottom center-left   → curve comes back down toward center
            -->
            <QuadCurve fx:id="leftCurve"
                       controlX="18.33334732055664"
                       controlY="-216.0"
                       endX="318.33331298828125"
                       endY="-15.000030517578125"
                       fill="#3A3AB6"
                       startX="-152.3333282470703"
                       startY="-15.000030517578125"
                       AnchorPane.bottomAnchor="-8.0"
                       AnchorPane.leftAnchor="-260.0" />

               <!--
                RIGHT curve (mirror of left):
                     start = bottom center-right
                     control = upper-right area
                     end = far bottom-right (off screen)
               -->
            <QuadCurve fx:id="rightCurve"
                       controlX="190.0"
                       controlY="-222.0"
                       endX="85.0"
                       endY="-16.0"
                       fill="#3A3AB6"
                       layoutX="677.0"
                       layoutY="133.0"
                       startX="-220.0"
                       startY="-15.0"
                       AnchorPane.bottomAnchor="-17.0"
                       AnchorPane.rightAnchor="-24.0" />

        </AnchorPane>
    </bottom>
</BorderPane>
