    <bottom>
        <VBox alignment="CENTER" prefHeight="125.0" spacing="10">
            <Pane prefHeight="39" />

            <HBox alignment="CENTER">
                <Button fx:id="bRetour" onAction="#bRetourClick" prefHeight="39.0" prefWidth="200.0" text="RETOUR" textFill="#024010">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
            </HBox>

            <AnchorPane prefHeight="39.0">
                <children>
                    <QuadCurve fx:id="leftCurve"
                               controlX="18.0" controlY="-216.0"
                               endX="318.0" endY="-15.0"
                               fill="#3A3AB6"
                               startX="-152.0" startY="-15.0"
                               strokeWidth="0.0"
                               AnchorPane.bottomAnchor="-10.0"
                               AnchorPane.leftAnchor="-221.0" />

                    <QuadCurve fx:id="rightCurve"
                               controlX="190.0" controlY="-222.0"
                               endX="85.0" endY="-16.0"
                               fill="#3A3AB6"
                               startX="-220.0" startY="-15.0"
                               strokeWidth="0.0"
                               AnchorPane.bottomAnchor="0.3333333333333286"
                               AnchorPane.rightAnchor="-41.40777587890625" />


                </children>
            </AnchorPane>
        </VBox>
