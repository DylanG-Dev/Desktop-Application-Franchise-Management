<!-- Remplace de la balise 'Pane' par 'BorderPane' pour
rendre la page responsive
Suppression des attributs 'maxHeight', 'maxWidth',
'minHeight', 'minWidth', 'prefHeight' et 'prefWidth'
qui empêche la responsivité car il fixe la taille-->

<BorderPane stylesheets="@./css/main.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinema.controllers.ListeFranchiseController">
    <!-- Remplacement des balises 'children' par les balises
     'top', 'center' et 'bottom' -->
    <!-- Balise 'top' pour le haut de la page -->
    <top>
        <!-- Suppression de la balise 'Vbox' qui ne sert
        pas et empêche la responsivité avec les attributs
        'layoutX', 'prefHeight' et 'prefWidth' -->
        <MenuBar>
            <menus>
                <Menu fx:id="gestionFranchise" mnemonicParsing="false" text="Gestion franchises">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image>
                                <Image url="@../images/franchise_64x64.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bListeFranchise" mnemonicParsing="false" onAction="#bListFranchiseClick" text="Liste franchises" />
                        <MenuItem fx:id="bAjouterFranchise" mnemonicParsing="false" onAction="#bAjouterFranchiseClick" text="Ajouter une franchise" />
                    </items>
                </Menu>
                <Menu fx:id="gestionCinema" mnemonicParsing="false" text="Gestion section">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image>
                                <Image url="@../images/cinema_32x32.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bListeCinema" mnemonicParsing="false" onAction="#bListeCinemaClick" text="Liste des sections" />
                        <MenuItem fx:id="bAjouterCinema" mnemonicParsing="false" onAction="#bAjouterCinemaClick" text="Ajouter une section" />
                    </items>
                </Menu>
                <Menu fx:id="gestionSalle" mnemonicParsing="false" text="Gestion salles">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image>
                                <Image url="@../images/salle_32x32.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bListeSalle" mnemonicParsing="false" onAction="#bListeSalleClick" text="Liste cours" />
                        <MenuItem fx:id="bAjouterSalle" mnemonicParsing="false" onAction="#bAjouterSalleClick" text="Ajouter un cours" />
                    </items>
                </Menu>
                <Menu fx:id="bAutres" mnemonicParsing="false" text="Autres">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <image>
                                <Image url="@../images/info.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <items>
                        <MenuItem fx:id="bAccueil" mnemonicParsing="false" onAction="#bAccueilClick" text="Accueil" />
                        <MenuItem fx:id="bQuitter" mnemonicParsing="false" onAction="#bQuitterClick" text="Quitter" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <!-- Balise 'center' pour le centre de la page -->
    <center>
        <!-- Ajout d'une balise 'VBox' pour ajouter de la
        responsivité avec l'attribut 'VBox.vgrow' initialisé
        avec la valeur 'ALWAYS' -->

        <VBox VBox.vgrow="ALWAYS">
            <!-- Suppression des attributs 'layoutY',
            'prefWidth' et 'prefHeight' qui empêche la
            responsivité -->
            <TableView fx:id="tvFranchises" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tcNomFranchise" prefWidth="150.0" text="tcNomFranchise" />
                    <TableColumn fx:id="tcSiegeSocial" prefWidth="160.0" text="tcSiegeSocial" />
                    <TableColumn fx:id="tcGerant" prefWidth="210.0" text="tcGerant" />
                    <TableColumn fx:id="tcSupprimer" prefWidth="110.0" text="tcSupprimer" />
                    <TableColumn fx:id="tcModifier" prefWidth="110.0" text="tcModifier" />
                </columns>
            </TableView>
        </VBox>
    </center>

