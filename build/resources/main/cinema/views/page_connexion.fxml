<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Fond rouge plein écran -->
<StackPane
        prefWidth="600"
        prefHeight="500"
        style="-fx-background-color: #991917;"
        xmlns="http://javafx.com/javafx/22"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinema.controllers.ConnexionController">

    <!-- Carte blanche centrée -->
    <VBox
            alignment="CENTER"
            maxWidth="420"
            spacing="0"
            style="
                -fx-background-color: white;
                -fx-background-radius: 10;
            ">

        <!-- Header : logo + titre -->
        <VBox alignment="CENTER" spacing="8"
              style="-fx-background-color: #991917; -fx-background-radius: 10 10 0 0;">
            <padding>
                <Insets top="24" bottom="20" left="40" right="40"/>
            </padding>

            <ImageView fitHeight="65" fitWidth="65" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/cinema_logo.png"/>
                </image>
            </ImageView>

            <Label text="CONNEXION"
                   style="
                       -fx-text-fill: white;
                       -fx-font-size: 20px;
                       -fx-font-weight: bold;
                   "/>
        </VBox>

        <!-- Formulaire -->
        <VBox spacing="14">
            <padding>
                <Insets top="28" bottom="28" left="40" right="40"/>
            </padding>

            <!-- Champ LOGIN -->
            <VBox spacing="5">
                <Label text="LOGIN"
                       style="-fx-text-fill: #555555; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <!-- Email écrit dans l'attribut 'text' pour l'utilisateur 'jean.dupont@email.com' -->
                <TextField fx:id="tfLogin" text=""
                           promptText="Entrez votre login"
                           style="
                               -fx-background-color: #f5f5f5;
                               -fx-background-radius: 6;
                               -fx-border-color: #dddddd;
                               -fx-border-radius: 6;
                               -fx-border-width: 1.5;
                               -fx-padding: 9 12;
                               -fx-font-size: 13px;
                           "/>
            </VBox>

            <!-- Champ MOT DE PASSE -->
            <VBox spacing="5">
                <Label text="MOT DE PASSE"
                       style="-fx-text-fill: #555555; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <!-- Mot de passe écrit dans l'attribut 'text' pour l'utilisateur 'jean.dupont@email.com' -->
                <PasswordField fx:id="tfMDP" text=""
                               promptText="Entrez votre mot de passe"
                               style="
                                   -fx-background-color: #f5f5f5;
                                   -fx-background-radius: 6;
                                   -fx-border-color: #dddddd;
                                   -fx-border-radius: 6;
                                   -fx-border-width: 1.5;
                                   -fx-padding: 9 12;
                                   -fx-font-size: 13px;
                               "/>
            </VBox>

            <!-- Ajouter une option mot de passe oublié ici -->
            <!--                <HBox>-->
            <!--                    <children>-->
            <!--                        <Hyperlink text="Mot de passe oublié" onAction="#showResetPassword">-->
            <!--                            <HBox.margin>-->
            <!--                                <Insets bottom="0" left="170.0" top="-12" />-->
            <!--                            </HBox.margin>-->
            <!--                        </Hyperlink>-->
            <!--                    </children>-->
            <!--                </HBox>-->

            <Separator style="-fx-background-color: #eeeeee;">
                <VBox.margin>
                    <Insets top="4" bottom="4"/>
                </VBox.margin>
            </Separator>

            <!-- Bouton connexion -->
            <Button fx:id="bConnexion"
                    text="Connexion"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#bConnexionClick"
                    style="
                        -fx-background-color: #991917;
                        -fx-background-radius: 6;
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-padding: 11 0;
                        -fx-cursor: hand;
                    "/>

        </VBox>
    </VBox>
</StackPane>
